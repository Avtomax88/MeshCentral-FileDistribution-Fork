<html>
<head>
    <script type="text/javascript" src="scripts/common-0.0.1.js"></script>
    <script type="text/javascript" src="pluginadmin.ashx?pin=filedist&include=1&path=fdlang.js"></script>
</head>
<style>
    body { font-family: "Trebuchet MS", Arial, Helvetica, sans-serif; font-size: 13px; margin: 0; padding: 6px; }
    h3 { font-size: 14px; margin: 0 0 8px 0; }
    .fdPanel { border: 1px solid #d8d8d8; margin-bottom: 12px; background: #fff; }
    .fdPanelHead { background: #f4f4f4; border-bottom: 1px solid #e0e0e0; padding: 7px 10px;
                   font-weight: bold; display: flex; align-items: center; }
    .fdPanelHead .grow { flex: 1; }
    .fdPanelHead button { margin-left: 6px; }
    /* Each panel gets its own resize handle so the three blocks can be sized
       independently; a drag handle appears at the bottom-right corner. */
    .fdPanelBody { padding: 10px; resize: vertical; overflow: hidden; min-height: 40px;
                   display: flex; flex-direction: column; }
    /* Children stretch with the panel instead of carrying their own handles. */
    .fdGrow { flex: 1; min-height: 0; display: flex; }
    .fdFixed { flex: 0 0 auto; }
    .fdRow { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 8px; }
    /* The growing row fills the panel, so its columns start at the top rather
       than sitting on the baseline like the short rows do. */
    .fdRow.fdGrow { align-items: stretch; flex-wrap: nowrap; }
    .fdRow.fdGrow > .fdCol { display: flex; flex-direction: column; min-height: 0; }
    .fdCol { flex: 1; min-width: 180px; }
    .fdCol label { display: block; color: #555; margin-bottom: 3px; }
    input[type=text] { width: 100%; box-sizing: border-box; padding: 4px; }
    button { padding: 4px 12px; cursor: pointer; }
    button:disabled { cursor: default; opacity: 0.5; }

    .fdPills { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px; }
    .fdPill { border: 1px solid #c4c4c4; border-radius: 12px; padding: 2px 10px; cursor: pointer; background: #fff; }
    .fdPill.on { background: #1e6fd9; border-color: #1e6fd9; color: #fff; }
    .fdPill .cnt { opacity: 0.75; margin-left: 5px; }

    .fdLists { display: flex; gap: 10px; align-items: stretch; }
    .fdListBox { border: 1px solid #d8d8d8; overflow: auto; padding: 4px; min-height: 0; }
    #fdNodeBox { flex: 2; }
    #fdMeshBox, #fdTagBox { flex: 1; }
    .fdListHead { font-weight: bold; color: #555; padding: 2px 4px 5px 4px; }
    .fdItem { display: block; padding: 2px 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fdItem:hover { background: #eef4fb; }
    .fdDot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin: 0 5px; }
    .fdOn { background: #3c9a3c; } .fdOff { background: #b03030; }
    .fdCount { color: #555; margin-left: 8px; }

    #fdFileBox { border: 1px solid #d8d8d8; overflow: auto; min-height: 0; flex: 1; }
    .fdFile { padding: 3px 5px; cursor: pointer; }
    .fdFile:hover { background: #eef4fb; }
    .fdFile.sel { background: #dceaf7; font-weight: bold; }

    .fdRecentWrap { margin-top: 6px; }
    .fdRecentLbl { color: #666; margin-right: 4px; }
    .fdRecentChip { display: inline-block; border: 1px solid #dcdcdc; border-radius: 9px; padding: 0 8px;
                    margin: 3px 4px 0 0; background: #fafafa; cursor: pointer; font-family: Consolas, monospace; }
    .fdRecentChip:hover { background: #eef4fb; }

    table.fdOv { width: 100%; border-collapse: collapse; }
    table.fdOv th { text-align: left; padding: 5px 6px; border-bottom: 2px solid #b3b3b3; position: sticky; top: 0; background: #fff; }
    table.fdOv td { padding: 4px 6px; border-bottom: 1px solid #e4e4e4; vertical-align: top; word-break: break-all; }
    .fdMono { font-family: Consolas, monospace; }
    .fdMuted { color: #666; }
    .fdNodeChips { margin-top: 4px; }
    .fdChip { display: inline-block; border: 1px solid #dcdcdc; border-radius: 9px;
              padding: 0 3px 0 7px; margin: 2px 3px 0 0; background: #fafafa; }
    .fdChip .x { cursor: pointer; color: #b03030; font-weight: bold; margin-left: 5px; padding: 0 2px; }
    .fdChip .x:hover { text-decoration: underline; }

    #fdOverlay { display: none; position: fixed; left: 0; top: 0; right: 0; bottom: 0;
                 background: rgba(0,0,0,0.35); z-index: 1000; }
    #fdDlg { position: absolute; left: 50%; top: 40px; transform: translateX(-50%);
             background: #fff; border: 1px solid #808080; min-width: 420px; max-width: 90%; }
    #fdDlgHead { background: #f0f0f0; border-bottom: 1px solid #d0d0d0; padding: 7px 10px; font-weight: bold; }
    #fdDlgBody { padding: 10px; max-height: 60vh; overflow: auto; }
    #fdDlgFoot { padding: 8px 10px; text-align: right; border-top: 1px solid #e0e0e0; }
    #fdDlgFoot button { margin-left: 6px; }
    #fdErr { color: #7a2020; padding: 6px 10px; display: none; }
    #fdMsg { padding: 8px 10px; margin-bottom: 10px; display: none; }
    .okMsg { background: #f0f7f0; border: 1px solid #b4d8b4; color: #20521f; }
    .errMsg { background: #fdf0f0; border: 1px solid #e0b4b4; color: #7a2020; }
</style>
<body onload="fdInit();">

<div id="fdMsg"></div>

<div class="fdPanel">
  <div class="fdPanelHead"><span class="grow" data-i18n="distributePanel">Distribute a file to many devices</span>
    <button onclick="fdOpenSettings();" title="My Devices button settings"data-i18n="settings">Settings</button>
    <button onclick="fdToggleBig();" id="fdBigBtn" title="Use the whole window" data-i18n-title="expandTitle"data-i18n="expand">Expand</button></div>
  <div class="fdPanelBody">

    <div class="fdRow fdGrow">
      <div class="fdCol" style="flex:2;display:flex;flex-direction:column;">
        <label class="fdFixed" data-i18n="fileFromMyFiles">File from My Files</label>
        <div id="fdFileBox"></div>
      </div>
      <div class="fdCol">
        <label data-i18n="folderOnDevices">Folder on the devices</label>
        <input type="text" id="fdFolder" placeholder="C:\Users\Public\Desktop" data-i18n-ph="folderPlaceholder" oninput="fdPreview();" />
        <div class="fdRecentWrap" id="fdRecentWrap"></div>
        <label style="margin-top:8px;" data-i18n="saveAs">Save as (empty keeps the original name)</label>
        <input type="text" id="fdName" oninput="fdPreview();" />
        <div class="fdMuted" style="margin-top:6px;">Will be written to (existing file with the same name is replaced):</div>
        <div id="fdPrev" class="fdMono">&mdash;</div>
      </div>
    </div>

  </div>
</div>

<div class="fdPanel">
  <div class="fdPanelHead"><span class="grow" data-i18n="devicesPanel">Devices</span></div>
  <div class="fdPanelBody">
    <div class="fdPills">
      <span class="fdPill on" id="fdPillAll" onclick="fdSetPill('all');"><span data-i18n="all">All</span><span class="cnt" id="fdCntAll">0</span></span>
      <span class="fdPill" id="fdPillOnline" onclick="fdSetPill('online');"><span data-i18n="online">Online</span><span class="cnt" id="fdCntOnline">0</span></span>
      <span class="fdPill" id="fdPillOffline" onclick="fdSetPill('offline');"><span data-i18n="offline">Offline</span><span class="cnt" id="fdCntOffline">0</span></span>
    </div>
    <div class="fdRow">
      <div class="fdCol" style="flex:3;">
        <input type="text" id="fdNodeFilter" placeholder="Filter devices by name" data-i18n-ph="filterDevices" oninput="fdRenderNodes();" />
      </div>
      <div class="fdCol" style="flex:0 0 auto;">
        <button onclick="fdSelectVisible(true);"data-i18n="selectShown">Select shown</button>
        <button onclick="fdSelectVisible(false);"data-i18n="clearShown">Clear shown</button>
        <button onclick="fdClearAll();"data-i18n="clearAll">Clear all</button>
      </div>
    </div>
    <div class="fdLists fdGrow">
      <div class="fdListBox" id="fdNodeBox"></div>
      <div class="fdListBox" id="fdMeshBox"></div>
      <div class="fdListBox" id="fdTagBox"></div>
    </div>
    <div style="margin-top:10px;display:flex;align-items:center;">
      <button onclick="fdDistribute();" id="fdGo"data-i18n="distribute">Distribute</button>
      <span class="fdCount" id="fdSelCount">0 of 0 selected</span>
    </div>
  </div>
</div>

<div class="fdPanel">
  <div class="fdPanelHead"><span class="grow" data-i18n="currentPanel">Current distributions</span>
    <button onclick="fdLoadOverview();"data-i18n="refresh">Refresh</button></div>
  <div class="fdPanelBody">
    <div class="fdGrow" style="overflow:auto;display:block;"><table class="fdOv"><thead><tr>
      <th width="30%">File</th><th width="30%">Path on device</th><th width="30%">Devices</th><th width="10%"></th>
    </tr></thead><tbody id="fdOvBody"></tbody></table></div>
    <div id="fdOvEmpty" class="fdMuted" style="padding:10px 4px;">Nothing is being distributed yet.</div>
  </div>
</div>

<div id="fdOverlay" onclick="if (event.target === this) fdClose();">
  <div id="fdDlg">
    <div id="fdDlgHead">&nbsp;</div>
    <div id="fdDlgBody"></div>
    <div id="fdErr"></div>
    <div id="fdDlgFoot">
      <button onclick="fdClose();" data-i18n="cancel">Cancel</button>
      <button id="fdOk" onclick="fdConfirm();">OK</button>
    </div>
  </div>
</div>
</body>
<script type="text/javascript">
var fdNodes = [];        // {id, name, meshid, online, tags:[]}
var fdMeshes = [];       // {id, name}
var fdSel = {};          // node id -> true
var fdMeshSel = {};      // mesh id -> true
var fdTagSel = {};       // tag -> true
var fdPill = 'all';
var fdFiles = [];        // {linkpath, nicepath}
var fdPicked = '';
var fdOverview = [];
var fdOnOk = null;
var fdBig = false;
var fdCanManageUi = false;

var RECENT_KEY = 'fd_recentFolders';
var RECENT_MAX = 10;

// The page runs either as a frame inside MeshCentral or as a standalone tab
// opened from the My Devices button. In the second case the host window is the
// opener, not the parent, and everything here is read from it.
function fdHost() {
    try { if (window.parent && (window.parent !== window) && window.fdHost().meshserver) return window.parent; } catch (e) { }
    try { if (window.opener && window.opener.meshserver) return window.opener; } catch (e) { }
    return window.parent || window;
}
function fdHostOk() {
    try { return (fdHost().meshserver != null); } catch (e) { return false; }
}

var T = null;
function fdInitLang() {
    var hostLang = null;
    try { var h = fdHost(); hostLang = h.currentUserLanguage || (h.navigator ? h.navigator.language : null); } catch (e) { }
    var lang = 'en';
    try { lang = fdPickLang(hostLang); } catch (e) { }
    try { T = fdMakeT(lang); } catch (e) { T = function (k) { return k; }; }
    window.fdCurLang = lang;
}
function fdApplyLang() {
    if (T == null) return;
    var i, els;
    els = document.querySelectorAll('[data-i18n]');
    for (i = 0; i < els.length; i++) { els[i].textContent = T(els[i].getAttribute('data-i18n')); }
    els = document.querySelectorAll('[data-i18n-ph]');
    for (i = 0; i < els.length; i++) { els[i].placeholder = T(els[i].getAttribute('data-i18n-ph')); }
    els = document.querySelectorAll('[data-i18n-title]');
    for (i = 0; i < els.length; i++) { els[i].title = T(els[i].getAttribute('data-i18n-title')); }
}

function fdEsc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function fdShow(kind, text) {
    var d = document.getElementById('fdMsg');
    d.className = (kind == 'ok') ? 'okMsg' : 'errMsg';
    d.textContent = text; d.style.display = 'block';
    if (kind == 'ok') { setTimeout(function () { d.style.display = 'none'; }, 6000); }
}
function fdOpen(title, body, onOk, okLabel) {
    document.getElementById('fdDlgHead').textContent = title;
    document.getElementById('fdDlgBody').innerHTML = body;
    document.getElementById('fdErr').style.display = 'none';
    document.getElementById('fdOk').textContent = (okLabel || 'OK');
    document.getElementById('fdOk').style.display = (onOk == null) ? 'none' : '';
    fdOnOk = onOk;
    document.getElementById('fdOverlay').style.display = 'block';
}
function fdClose() { document.getElementById('fdOverlay').style.display = 'none'; fdOnOk = null; }
function fdConfirm() { if (fdOnOk != null) fdOnOk(); }
function fdDlgErr(t) { var d = document.getElementById('fdErr'); d.textContent = t; d.style.display = 'block'; }
document.addEventListener('keydown', function (e) {
    if (document.getElementById('fdOverlay').style.display != 'block') return;
    if (e.key == 'Escape') fdClose();
});

function fdToggleBig() {
    var btn = document.getElementById('fdBigBtn');
    if (!fdBig) {
        var el = document.documentElement;
        var req = el.requestFullscreen || el.webkitRequestFullscreen;
        if (req) {
            try {
                var p = req.call(el);
                if (p && p.catch) { p.catch(function () { fdTallMode(true); }); }
                fdBig = true; btn.textContent = T('collapse'); return;
            } catch (e) { }
        }
        fdTallMode(true); fdBig = true; btn.textContent = T('collapse');
    } else {
        if (document.fullscreenElement && document.exitFullscreen) { try { document.exitFullscreen(); } catch (e) { } }
        fdTallMode(false); fdBig = false; btn.textContent = T('expand');
    }
}
// Panel heights are remembered per browser. Each panel body carries the resize
// handle now, and its children stretch to follow.
var FD_DEF_H = [190, 300, 220];
function fdPanels() { return document.querySelectorAll('.fdPanelBody'); }
function fdLoadHeights() {
    var saved = {};
    try { saved = JSON.parse(localStorage.getItem('fd_panel_heights') || '{}'); } catch (e) { saved = {}; }
    var ps = fdPanels();
    for (var i = 0; i < ps.length; i++) {
        var h = saved[i];
        ps[i].style.height = ((typeof h == 'number') && (h > 30) ? h : FD_DEF_H[i] || 240) + 'px';
    }
}
function fdSaveHeights() {
    var ps = fdPanels(), out = {};
    for (var i = 0; i < ps.length; i++) { out[i] = ps[i].offsetHeight; }
    try { localStorage.setItem('fd_panel_heights', JSON.stringify(out)); } catch (e) { }
}
function fdWatchHeights() {
    if (typeof ResizeObserver != 'function') return;
    var t = null;
    var ro = new ResizeObserver(function () {
        if (t) clearTimeout(t);
        t = setTimeout(fdSaveHeights, 400);
    });
    var ps = fdPanels();
    for (var i = 0; i < ps.length; i++) { ro.observe(ps[i]); }
}
function fdTallMode(on) {
    var ps = fdPanels();
    for (var i = 0; i < ps.length; i++) {
        ps[i].style.height = on ? Math.max(320, Math.round((window.innerHeight - 180) / ps.length)) + 'px'
                                : ((FD_DEF_H[i] || 240) + 'px');
    }
    if (!on) { fdLoadHeights(); }
}
document.addEventListener('fullscreenchange', function () {
    if (!document.fullscreenElement && fdBig) { fdTallMode(false); fdBig = false; document.getElementById('fdBigBtn').textContent = T('expand'); }
});

function fdInit() {
    fdInitLang();
    fdApplyLang();
    if (!fdHostOk()) {
        document.body.innerHTML = '<div style="padding:20px;font-family:Arial;">' +
          (T ? T('hostGone') : 'This page needs the MeshCentral window it was opened from.') + '<br><br>' +
          (T ? T('hostGoneHint') : '') + '</div>';
        return;
    }
    fdReadNodes();
    fdReadFiles();
    fdRenderMeshes();
    fdRenderTags();
    fdRenderNodes();
    fdRenderFiles();
    fdRenderRecent();
    fdApplyPreselect();
    fdLoadHeights();
    fdWatchHeights();
    fdHost().pluginHandler.filedist.loadOverview = function (msg) { fdOnOverview(msg.event); };
    fdHost().pluginHandler.filedist.onBulkResult = function (msg) { fdOnBulk(msg.event); };
    fdHost().pluginHandler.filedist.onUiConfig = function (msg) { fdOnUiConfig(msg.event); };
    fdLoadOverview();
    try { fdHost().meshserver.send({ action: 'plugin', plugin: 'filedist', pluginaction: 'getUiConfig' }); } catch (e) { }
}

// Devices passed in via ?preselect=id1,id2 from the My Devices toolbar button.
function fdApplyPreselect() {
    var m = /[?&]preselect=([^&]+)/.exec(window.location.search);
    if (m == null) return;
    decodeURIComponent(m[1]).split(',').forEach(function (id) { if (id) fdSel[id] = true; });
    fdRenderNodes();
    if (Object.keys(fdSel).length > 0) { fdShow('ok', Object.keys(fdSel).length + ' device(s) carried over from My Devices.'); }
}

// The host page keeps the device list on window; it is only a convenience here,
// since the server re-checks rights on every node before it writes anything.
function fdReadNodes() {
    fdNodes = []; fdMeshes = [];
    try {
        var ms = fdHost().meshes || {};
        for (var k in ms) { if (ms[k] && (ms[k].mtype == 2)) { fdMeshes.push({ id: k, name: ms[k].name || k }); } }
        fdMeshes.sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
        var ns = fdHost().nodes || [];
        for (var i = 0; i < ns.length; i++) {
            var n = ns[i];
            if (n.mtype != 2) continue;
            var tags = Array.isArray(n.tags) ? n.tags.filter(function (t) { return t && String(t).trim() != ''; }) : [];
            fdNodes.push({ id: n._id, name: n.name || n._id, meshid: n.meshid, online: ((n.conn != null) && (n.conn > 0)), tags: tags });
        }
        fdNodes.sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
    } catch (e) { }
    document.getElementById('fdCntAll').textContent = fdNodes.length;
    document.getElementById('fdCntOnline').textContent = fdNodes.filter(function (n) { return n.online; }).length;
    document.getElementById('fdCntOffline').textContent = fdNodes.filter(function (n) { return !n.online; }).length;
}

function fdReadFiles() {
    fdFiles = [];
    try {
        var loc = [], nice = [];
        var walk = function (tree) {
            for (var k in tree) {
                var v = tree[k];
                if (v.t != 3) { if (v.t == 4) { loc = []; nice = []; } loc.push(k); nice.push(v.n || k); }
                if ((v.t <= 2) || (v.t == 4)) walk(v.f);
                if (v.t == 3) { fdFiles.push({ linkpath: loc.join('/') + '/' + k, nicepath: nice.join('/') + '/' + k }); }
            }
            loc.pop(); nice.pop();
        };
        if (fdHost().filetree && fdHost().filetree.f) walk(fdHost().filetree.f);
    } catch (e) { fdFiles = []; }
}

function fdRenderFiles() {
    var box = document.getElementById('fdFileBox');
    if (fdFiles.length == 0) { box.innerHTML = '<div class="fdMuted" style="padding:8px;">No files under My Files. Upload one on the Files tab first.</div>'; return; }
    var h = '';
    fdFiles.forEach(function (f) {
        h += '<div class="fdFile" data-p="' + fdEsc(f.linkpath) + '" onclick="fdPickFile(this);">' + fdEsc(f.nicepath) + '</div>';
    });
    box.innerHTML = h;
}
function fdPickFile(el) {
    fdPicked = el.getAttribute('data-p');
    var all = document.querySelectorAll('.fdFile');
    for (var i = 0; i < all.length; i++) all[i].classList.remove('sel');
    el.classList.add('sel');
    fdPreview();
}
function fdBaseName(p) { var a = String(p || '').split('/'); return a[a.length - 1]; }
function fdJoin(folder, name) {
    folder = String(folder || '').trim();
    if (folder == '') return '';
    var sep = ((folder.indexOf('\\') != -1) || /^[A-Za-z]:/.test(folder)) ? '\\' : '/';
    var t = folder.replace(/[\\\/]+$/, '');
    if (t == '') t = folder.charAt(0);
    return t + sep + name;
}
function fdPreview() {
    var name = document.getElementById('fdName').value.trim();
    if (name == '') name = fdBaseName(fdPicked);
    var full = (fdPicked == '') ? '' : fdJoin(document.getElementById('fdFolder').value, name);
    document.getElementById('fdPrev').textContent = (full == '') ? '\u2014' : full;
}

// ---- Recent folders (kept in this browser only, via localStorage) ----
function fdRecentGet() {
    try { var a = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]'); return Array.isArray(a) ? a : []; }
    catch (e) { return []; }
}
function fdRecentAdd(folder) {
    folder = String(folder || '').trim();
    if (folder == '') return;
    try {
        var a = fdRecentGet().filter(function (x) { return x != folder; });
        a.unshift(folder);
        if (a.length > RECENT_MAX) a = a.slice(0, RECENT_MAX);
        localStorage.setItem(RECENT_KEY, JSON.stringify(a));
    } catch (e) { }
    fdRenderRecent();
}
function fdRenderRecent() {
    var a = fdRecentGet(), box = document.getElementById('fdRecentWrap');
    if (a.length == 0) { box.innerHTML = ''; return; }
    var h = '<span class="fdRecentLbl">Recent:</span>';
    a.forEach(function (p) { h += '<span class="fdRecentChip" onclick="fdUseRecent(this);" data-p="' + fdEsc(p) + '">' + fdEsc(p) + '</span>'; });
    box.innerHTML = h;
}
function fdUseRecent(el) {
    document.getElementById('fdFolder').value = el.getAttribute('data-p');
    fdPreview();
}

function fdRenderMeshes() {
    var h = '<div class="fdListHead">' + T('groupsHead') + '</div>';
    fdMeshes.forEach(function (m) {
        h += '<label class="fdItem"><input type="checkbox" data-mesh="' + fdEsc(m.id) + '" onchange="fdMeshToggle(this);"> ' + fdEsc(m.name) + '</label>';
    });
    document.getElementById('fdMeshBox').innerHTML = h;
}
function fdMeshToggle(cb) {
    var id = cb.getAttribute('data-mesh');
    if (cb.checked) fdMeshSel[id] = true; else delete fdMeshSel[id];
    fdRenderNodes();
}

function fdAllTags() {
    var counts = {};
    fdNodes.forEach(function (n) { n.tags.forEach(function (t) { counts[t] = (counts[t] || 0) + 1; }); });
    return Object.keys(counts).sort().map(function (t) { return { tag: t, count: counts[t] }; });
}
function fdRenderTags() {
    var tags = fdAllTags(), box = document.getElementById('fdTagBox');
    var h = '<div class="fdListHead">' + T('tagsHead') + '</div>';
    if (tags.length == 0) { h += '<div class="fdMuted" style="padding:6px;">No device has a tag yet.</div>'; }
    tags.forEach(function (t) {
        h += '<label class="fdItem"><input type="checkbox" data-tag="' + fdEsc(t.tag) + '" onchange="fdTagToggle(this);"> ' +
             fdEsc(t.tag) + ' <span class="fdMuted">(' + t.count + ')</span></label>';
    });
    box.innerHTML = h;
}
function fdTagToggle(cb) {
    var t = cb.getAttribute('data-tag');
    if (cb.checked) fdTagSel[t] = true; else delete fdTagSel[t];
    fdRenderNodes();
}

function fdVisibleNodes() {
    var f = document.getElementById('fdNodeFilter').value.trim().toLowerCase();
    var meshFilter = Object.keys(fdMeshSel);
    var tagFilter = Object.keys(fdTagSel);
    return fdNodes.filter(function (n) {
        if ((fdPill == 'online') && !n.online) return false;
        if ((fdPill == 'offline') && n.online) return false;
        if ((meshFilter.length > 0) && (fdMeshSel[n.meshid] !== true)) return false;
        if (tagFilter.length > 0) {
            var has = false;
            for (var i = 0; i < n.tags.length; i++) { if (fdTagSel[n.tags[i]] === true) { has = true; break; } }
            if (!has) return false;
        }
        if ((f.length > 0) && (n.name.toLowerCase().indexOf(f) == -1)) return false;
        return true;
    });
}
function fdSetPill(v) {
    fdPill = v;
    ['All', 'Online', 'Offline'].forEach(function (n) {
        document.getElementById('fdPill' + n).classList.toggle('on', n.toLowerCase() == v);
    });
    fdRenderNodes();
}
function fdRenderNodes() {
    var vis = fdVisibleNodes(), h = '<div class="fdListHead">' + T('devicesHead') + ' (' + vis.length + ')</div>';
    if (vis.length == 0) { h += '<div class="fdMuted" style="padding:6px;">No device matches these filters.</div>'; }
    vis.forEach(function (n) {
        h += '<label class="fdItem"><input type="checkbox" data-node="' + fdEsc(n.id) + '"' +
             ((fdSel[n.id] === true) ? ' checked' : '') + ' onchange="fdNodeToggle(this);">' +
             '<span class="fdDot ' + (n.online ? 'fdOn' : 'fdOff') + '"></span>' + fdEsc(n.name) + '</label>';
    });
    document.getElementById('fdNodeBox').innerHTML = h;
    fdUpdateCount();
}
function fdNodeToggle(cb) {
    var id = cb.getAttribute('data-node');
    if (cb.checked) fdSel[id] = true; else delete fdSel[id];
    fdUpdateCount();
}
function fdSelectVisible(on) {
    fdVisibleNodes().forEach(function (n) { if (on) fdSel[n.id] = true; else delete fdSel[n.id]; });
    fdRenderNodes();
}
function fdClearAll() { fdSel = {}; fdRenderNodes(); }
function fdUpdateCount() {
    document.getElementById('fdSelCount').textContent =
        T('selectedCount', Object.keys(fdSel).length, fdNodes.length);
}

function fdDistribute() {
    if (fdPicked == '') { fdShow('err', T('pickFileFirst')); return; }
    var folder = document.getElementById('fdFolder').value.trim();
    if (folder == '') { fdShow('err', T('enterFolder')); return; }
    var name = document.getElementById('fdName').value.trim();
    if (name == '') name = fdBaseName(fdPicked);
    if (/[\\\/]/.test(name)) { fdShow('err', T('noSlashInName')); return; }
    var ids = Object.keys(fdSel);
    if (ids.length == 0) { fdShow('err', T('selectDevice')); return; }
    var cpath = fdJoin(folder, name);
    fdOpen(T('distributeTitle'),
        'Send <b>' + fdEsc(fdBaseName(fdPicked)) + '</b> to <b>' + ids.length + '</b> device(s)?' +
        '<div class="fdMono" style="margin-top:8px;">' + fdEsc(cpath) + '</div>' +
        '<div class="fdMuted" style="margin-top:8px;">A file already at that path on a device is replaced. ' +
        'Devices you cannot manage are skipped. Offline devices receive the file when they next connect.</div>',
        function () {
            document.getElementById('fdGo').disabled = true;
            fdHost().meshserver.send({ action: 'plugin', plugin: 'filedist', pluginaction: 'addFileMapBulk',
                nodeids: ids, spath: fdPicked, cpath: cpath });
            fdRecentAdd(folder);
            fdClose();
        }, T('distribute'));
}

function fdLoadOverview() {
    fdHost().meshserver.send({ action: 'plugin', plugin: 'filedist', pluginaction: 'getOverview' });
}
function fdNodeName(id) {
    for (var i = 0; i < fdNodes.length; i++) { if (fdNodes[i].id == id) return fdNodes[i].name; }
    return id;
}
function fdFileNice(linkpath) {
    for (var i = 0; i < fdFiles.length; i++) { if (fdFiles[i].linkpath == linkpath) return fdFiles[i].nicepath; }
    return linkpath;
}
function fdOnOverview(ev) {
    fdOverview = (ev && ev.maps) ? ev.maps : [];
    var groups = {};
    fdOverview.forEach(function (m) {
        var key = m.serverpath + '\u0000' + m.clientpath;
        if (groups[key] == null) groups[key] = { serverpath: m.serverpath, clientpath: m.clientpath, ids: [], nodes: [] };
        groups[key].ids.push(m._id);
        groups[key].nodes.push(m.node);
    });
    var keys = Object.keys(groups).sort();
    var body = document.getElementById('fdOvBody');
    body.innerHTML = '';
    keys.forEach(function (k, idx) {
        var g = groups[k];
        var chips = g.nodes.map(function (n, j) {
            return '<span class="fdChip">' + fdEsc(fdNodeName(n)) +
                   '<span class="x" title="Remove just this device" onclick="fdRemoveOne(' + idx + ',' + j + ');">\u00d7</span></span>';
        }).join('');
        var tr = body.insertRow(-1);
        tr.innerHTML =
            '<td>' + fdEsc(fdFileNice(g.serverpath)) + '</td>' +
            '<td class="fdMono">' + fdEsc(g.clientpath) + '</td>' +
            '<td>' + T('deviceCount', g.nodes.length) + '<div class="fdNodeChips">' + chips + '</div></td>' +
            '<td><button onclick="fdRemoveGroup(' + idx + ');">Remove all</button></td>';
    });
    window.fdGroups = keys.map(function (k) { return groups[k]; });
    document.getElementById('fdOvEmpty').style.display = (keys.length == 0) ? '' : 'none';
}
function fdRemoveGroup(idx) {
    var g = window.fdGroups[idx];
    if (g == null) return;
    fdConfirmRemove(T('removeTitle'),
        'Stop distributing this file to <b>' + g.nodes.length + '</b> device(s)?',
        g.clientpath, g.ids);
}
function fdRemoveOne(idx, j) {
    var g = window.fdGroups[idx];
    if ((g == null) || (g.ids[j] == null)) return;
    fdConfirmRemove(T('removeTitle'),
        'Stop distributing this file to <b>' + fdEsc(fdNodeName(g.nodes[j])) + '</b>?',
        g.clientpath, [g.ids[j]]);
}
function fdConfirmRemove(title, question, clientpath, ids) {
    fdOpen(title,
        question +
        '<div class="fdMono" style="margin-top:8px;">' + fdEsc(clientpath) + '</div>' +
        '<div style="margin-top:10px;"><label><input type="checkbox" id="fdDelFileBulk"> Also delete the file from the device(s)</label></div>' +
        '<div class="fdMuted" style="margin-top:6px;">Only devices that are online right now can delete the file. ' +
        'A file that was replaced or edited on a device is left alone.</div>',
        function () {
            var del = document.getElementById('fdDelFileBulk').checked;
            fdHost().meshserver.send({ action: 'plugin', plugin: 'filedist', pluginaction: 'deleteMapsBulk', ids: ids, deleteFile: del });
            fdClose();
        }, T('remove'));
}

function fdOnBulk(ev) {
    document.getElementById('fdGo').disabled = false;
    var r = (ev && ev.result) ? ev.result : {};
    if (r.error) { fdShow('err', r.error); return; }
    if (ev.kind == 'add') {
        var t = T('addedTo', r.added);
        if (r.skipped > 0) t += ' ' + T('addSkipped', r.skipped);
        fdShow('ok', t);
    } else {
        var t2 = T('removedFrom', r.removed);
        if (r.skipped > 0) t2 += ' ' + T('removeSkipped', r.skipped);
        fdShow('ok', t2);
    }
    fdLoadOverview();
}

// ---- My Devices button settings ----
function fdOnUiConfig(ev) {
    fdCanManageUi = (ev && (ev.canManageUi === true));
    window.fdUiConfig = (ev && ev.config) ? ev.config : { devicesButton: false };
}
function fdOpenSettings() {
    var cfg = window.fdUiConfig || { devicesButton: false };
    var cur = 'auto';
    try { cur = localStorage.getItem('fd_lang') || 'auto'; } catch (e) { }
    var opts = '<option value="auto"' + ((cur == 'auto') ? ' selected' : '') + '>' + T('langAuto') + '</option>';
    var names = { en: 'English', ru: '\u0420\u0443\u0441\u0441\u043a\u0438\u0439' };
    for (var k in FD_STR) { opts += '<option value="' + k + '"' + ((cur == k) ? ' selected' : '') + '>' + (names[k] || k) + '</option>'; }
    var body =
        '<div style="margin-bottom:12px;"><b>' + T('language') + '</b><br>' +
        '<select id="fdLangSel" style="margin-top:4px;">' + opts + '</select></div>' +
        '<label><input type="checkbox" id="fdDevBtnChk"' + (cfg.devicesButton ? ' checked' : '') +
        (fdCanManageUi ? '' : ' disabled') + '> ' + T('settingsShow') + '</label>' +
        '<div class="fdMuted" style="margin-top:8px;">' + T('settingsNote') + '</div>' +
        (fdCanManageUi ? '' : '<div class="fdMuted" style="margin-top:8px;">' + T('settingsAdminOnly') + '</div>');
    fdOpen(T('settingsTitle'), body, function () {
        // Language is a per-browser choice and needs no rights.
        var sel = document.getElementById('fdLangSel').value;
        try { localStorage.setItem('fd_lang', sel); } catch (e) { }
        if (fdCanManageUi) {
            var on = document.getElementById('fdDevBtnChk').checked;
            fdHost().meshserver.send({ action: 'plugin', plugin: 'filedist', pluginaction: 'saveUiConfig', config: { devicesButton: on } });
        }
        fdClose();
        // Re-read the dictionary and repaint everything that is already on screen.
        fdInitLang(); fdApplyLang(); fdRenderNodes(); fdRenderMeshes(); fdRenderTags(); fdLoadOverview();
        fdShow('ok', T('settingsSaved'));
    }, T('save'));
}
</script>
</html>
