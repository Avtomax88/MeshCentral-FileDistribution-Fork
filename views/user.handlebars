<html>
<head>
    <script type="text/javascript" src="scripts/common-0.0.1.js"></script>
    <script type="text/javascript" src="pluginadmin.ashx?pin=filedist&include=1&path=fdlang.js"></script>
</head>
<style>
    body { font-family: "Trebuchet MS", Arial, Helvetica, sans-serif; font-size: 13px; margin: 0; padding: 4px; }
    #fdMaps { width: 100%; border-collapse: collapse; }
    #fdMaps th { text-align: left; padding: 5px 6px; border-bottom: 2px solid #b3b3b3; }
    #fdMaps td { padding: 4px 6px; border-bottom: 1px solid #dcdcdc; word-break: break-all; }
    #goAdd, .delMap { cursor: pointer; }
    #goAdd { display: inline-block; padding: 6px 2px; font-weight: bold; }
    .delMap { color: #b03030; font-weight: bold; }
    #fdEmpty { color: #666; padding: 10px 6px; }

    /* Own dialog. The host page's setDialogMode() exists in the modern theme but
       does not render, and parent.currentNode is out of reach from this frame, so
       the plugin no longer borrows either of them. */
    #fdOverlay { display: none; position: fixed; left: 0; top: 0; right: 0; bottom: 0;
                 background: rgba(0,0,0,0.35); z-index: 1000; }
    #fdDlg { position: absolute; left: 50%; top: 40px; transform: translateX(-50%);
             background: #fff; border: 1px solid #808080; box-shadow: 0 4px 18px rgba(0,0,0,0.3);
             min-width: 420px; max-width: 90%; }
    #fdDlgHead { background: #f0f0f0; border-bottom: 1px solid #d0d0d0; padding: 7px 10px; font-weight: bold; }
    #fdDlgBody { padding: 10px; max-height: 60vh; overflow: auto; }
    #fdDlgFoot { padding: 8px 10px; text-align: right; border-top: 1px solid #e0e0e0; }
    #fdDlgFoot input { margin-left: 6px; padding: 3px 14px; }
    .fdfh { padding: 3px 4px; cursor: pointer; }
    .fdfh:hover { background: #eef4fb; }
    .fdfh.sel { font-weight: bold; background: #dceaf7; }
    #fdFileList { max-height: 300px; overflow: auto; border: 1px solid #d8d8d8; margin-bottom: 8px; }
    #fdErr { color: #7a2020; padding: 6px 0; display: none; }
    .fdInput { width: 100%; box-sizing: border-box; padding: 4px; }
</style>
<body onload="doOnLoad();">
<div id="fileDistUser">
  <div id="fileDist_main">
      <table id="fdMaps">
          <tr><th width="40%" data-i18n="serverPath">Server Path</th><th width="40%" data-i18n="clientPath">Client Path</th><th width="20%" data-i18n="deleteCol">Delete</th></tr>
      </table>
      <div id="fdEmpty" data-i18n="noMapsHere">No files are distributed to this device yet.</div>
      <span id="goAdd" onclick="goAdd();">[+]</span>
  </div>
</div>

<div id="fdOverlay" onclick="if (event.target === this) fdClose();">
  <div id="fdDlg">
    <div id="fdDlgHead">&nbsp;</div>
    <div id="fdDlgBody"></div>
    <div id="fdErr"></div>
    <div id="fdDlgFoot">
      <input type="button" id="fdCancel" value="Cancel" data-i18n-val="cancel" onclick="fdClose();" />
      <input type="button" id="fdOk" value="OK" onclick="fdConfirm();" />
    </div>
  </div>
</div>
</body>
<script type="text/javascript">
var filemaps = {{{filemaps}}};
var sPathsToNPaths = {};
var fTree = [];
var loc = [];
var niceLoc = [];
var fdOnOk = null;
var fdSelectedPath = '';

// The host page keeps currentNode out of window scope in the modern theme, so the
// device is taken from the query string this frame was opened with instead.
function fdNodeId() {
    var m = /[?&]node=([^&]+)/.exec(window.location.search);
    return (m == null) ? null : decodeURIComponent(m[1]);
}

var T = null;
function fdInitLang() {
    var hostLang = null;
    try { hostLang = parent.currentUserLanguage || (parent.navigator ? parent.navigator.language : null); } catch (e) { }
    var lang = 'en';
    try { lang = fdPickLang(hostLang); } catch (e) { }
    try { T = fdMakeT(lang); } catch (e) { T = function (k) { return k; }; }
    var i, els = document.querySelectorAll('[data-i18n]');
    for (i = 0; i < els.length; i++) { els[i].textContent = T(els[i].getAttribute('data-i18n')); }
    els = document.querySelectorAll('[data-i18n-val]');
    for (i = 0; i < els.length; i++) { els[i].value = T(els[i].getAttribute('data-i18n-val')); }
}

function fdEsc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function fdOpen(title, bodyHtml, onOk, okLabel) {
    document.getElementById('fdDlgHead').textContent = title;
    document.getElementById('fdDlgBody').innerHTML = bodyHtml;
    document.getElementById('fdErr').style.display = 'none';
    document.getElementById('fdOk').value = (okLabel || 'OK');
    document.getElementById('fdOk').style.display = (onOk == null) ? 'none' : '';
    fdOnOk = onOk;
    document.getElementById('fdOverlay').style.display = 'block';
}
function fdClose() { document.getElementById('fdOverlay').style.display = 'none'; fdOnOk = null; }
function fdShowErr(text) {
    var d = document.getElementById('fdErr');
    d.textContent = text; d.style.display = 'block';
}
function fdConfirm() { var f = fdOnOk; if (f != null) { f(); } }
function fdFocus(id) { var el = document.getElementById(id); if (el != null) { el.focus(); } }

document.addEventListener('keydown', function (e) {
    if (document.getElementById('fdOverlay').style.display != 'block') return;
    if (e.key == 'Escape') { fdClose(); }
    if ((e.key == 'Enter') && (fdOnOk != null) && (e.target.tagName != 'TEXTAREA')) { fdConfirm(); }
});

function doOnLoad() {
  if (T == null) fdInitLang();
  fTree = []; loc = []; niceLoc = [];
  try { parseFileTree(); } catch (e) { fTree = []; }
  parseNicePaths();
  redrawMaps();
}
function parseNicePaths() {
    sPathsToNPaths = {};
    fTree.forEach(function(f) { sPathsToNPaths[f.linkpath] = f.nicepath; });
}
function redrawMaps() {
    var fdMapTbl = document.getElementById('fdMaps');
    var fdMapRows = document.querySelectorAll('.fmRow');
    for (var i = 0; i < fdMapRows.length; i++) { fdMapRows[i].parentNode.removeChild(fdMapRows[i]); }
    filemaps.forEach(function(m) {
        var nice = sPathsToNPaths[m.serverpath] || m.serverpath;
        var tpl = '<td>' + fdEsc(nice) + '</td>' +
                  '<td>' + fdEsc(m.clientpath) + '</td>' +
                  '<td><span class="delMap" onclick="deleteMap(this);">X</span></td>';
        var tr = fdMapTbl.insertRow(-1);
        tr.innerHTML = tpl;
        tr.classList.add('fmRow');
        tr.setAttribute('x-data-id', m._id);
    });
    document.getElementById('fdEmpty').style.display = (filemaps.length == 0) ? '' : 'none';
}

function goAdd() {
    fdSelectedPath = '';
    if (fTree.length == 0) {
        fdOpen(T('chooseFile'),
            T('noFilesUpload'), null);
        return;
    }
    var h = '<div id="fdFileList">';
    fTree.forEach(function (a) {
        h += '<div class="fdfh" x-data-spath="' + fdEsc(a.linkpath) + '" onclick="fileSelected(this);">' + fdEsc(a.nicepath) + '</div>';
    });
    h += '</div><div>Filter: <input id="fdfilter" class="fdInput" type="text" onkeyup="filterFiles(this);" /></div>';
    fdOpen(T('chooseFile'), h, goAddEx, T('next'));
    fdFocus('fdfilter');
}
function fileSelected(el) {
    fdSelectedPath = el.getAttribute('x-data-spath');
    var rows = document.querySelectorAll('.fdfh');
    for (var i = 0; i < rows.length; i++) { rows[i].classList.remove('sel'); }
    el.classList.add('sel');
}
function filterFiles(el) {
    var val = el.value.toLowerCase();
    var rows = document.querySelectorAll('.fdfh');
    for (var i = 0; i < rows.length; i++) {
        rows[i].style.display = (rows[i].textContent.toLowerCase().indexOf(val) >= 0) ? '' : 'none';
    }
}
// Splits a My Files link path into the folder part and the file name.
function fdBaseName(linkpath) {
    var p = String(linkpath == null ? '' : linkpath).split('/');
    return p[p.length - 1];
}

// Windows and POSIX targets are both possible, so the separator is taken from
// what the operator typed rather than assumed.
function fdJoin(folder, name) {
    folder = String(folder == null ? '' : folder).trim();
    if (folder == '') return '';
    var sep = ((folder.indexOf('\\') != -1) || /^[A-Za-z]:/.test(folder)) ? '\\' : '/';
    var trimmed = folder.replace(/[\\\/]+$/, '');
    if (trimmed == '') { trimmed = folder.charAt(0); } // folder was just a root separator
    return trimmed + sep + name;
}

function fdPreview() {
    var folder = document.getElementById('fdclientFolder').value;
    var nameEl = document.getElementById('fdclientName');
    var name = (nameEl.value.trim() == '') ? fdBaseName(fdSelectedPath) : nameEl.value.trim();
    var full = fdJoin(folder, name);
    document.getElementById('fdpreview').textContent = (full == '') ? '\u2014' : full;
}

function goAddEx() {
    if (fdSelectedPath == '') { fdShowErr(T('pickFileList')); return; }
    var keep = fdSelectedPath;
    var orig = fdBaseName(keep);
    fdOpen(T('chooseLocation'),
        '<div style="margin-bottom:6px;">Folder on the device:</div>' +
        '<input type="text" class="fdInput" placeholder="C:\\Users\\Public\\Desktop" id="fdclientFolder" list="fdFolderHist" oninput="fdPreview();" /><datalist id="fdFolderHist"></datalist>' +
        '<div style="margin:10px 0 6px 0;">Save as <span style="color:#666;">(leave empty to keep <b>' + fdEsc(orig) + '</b>)</span>:</div>' +
        '<input type="text" class="fdInput" placeholder="' + fdEsc(orig) + '" id="fdclientName" oninput="fdPreview();" />' +
        '<div style="margin-top:10px;color:#666;">Will be written to:</div>' +
        '<div id="fdpreview" style="font-family:Consolas,monospace;word-break:break-all;">\u2014</div>',
        function () { goAddEx2(keep); }, T('add'));
    fdFocus('fdclientFolder');
    // Same 10-entry history the bulk distribution page uses; typing here shares it.
    try {
        var hist = JSON.parse(localStorage.getItem('fd_recent_paths') || '[]');
        var list = document.getElementById('fdFolderHist');
        hist.forEach(function (p) { var o = document.createElement('option'); o.value = p; list.appendChild(o); });
    } catch (e) { }
}
function fdRememberFolder(folder) {
    folder = String(folder || '').trim();
    if (folder == '') return;
    try {
        var arr = JSON.parse(localStorage.getItem('fd_recent_paths') || '[]')
            .filter(function (x) { return x.toLowerCase() != folder.toLowerCase(); });
        arr.unshift(folder);
        localStorage.setItem('fd_recent_paths', JSON.stringify(arr.slice(0, 10)));
    } catch (e) { }
}
function goAddEx2(spath) {
    var folder = document.getElementById('fdclientFolder').value.trim();
    if (folder == '') { fdShowErr(T('enterFolder')); return; }
    var typed = document.getElementById('fdclientName').value.trim();
    var name = (typed == '') ? fdBaseName(spath) : typed;
    if (/[\\\/]/.test(name)) { fdShowErr(T('noSlashInNameLong')); return; }
    var cpath = fdJoin(folder, name);
    if (cpath == '') { fdShowErr(T('badFolder')); return; }
    var nodeid = fdNodeId();
    if (nodeid == null) { fdShowErr(T('noDeviceId')); return; }
    fdRememberFolder(folder);
    parent.meshserver.send({ action: 'plugin', plugin: 'filedist', pluginaction: 'addFileMap',
        spath: spath, cpath: cpath, currentNodeId: nodeid });
    fdClose();
}
function deleteMap(el) {
    var mid = el.parentNode.parentNode.getAttribute('x-data-id');
    fdOpen(T('removeTitle'),
        '<div style="margin-bottom:10px;">' + T('stopOnThisDevice') + '</div>' +
        '<label><input type="checkbox" id="fdDelFile" /> ' + T('alsoDelete') + '</label>' +
        '<div style="color:#666;margin-top:8px;">' + T('keepNote') + ' ' + T('deleteNote') + '</div>',
        function () {
            var del = document.getElementById('fdDelFile').checked;
            parent.meshserver.send({ action: 'plugin', plugin: 'filedist', pluginaction: 'deleteMap',
                id: mid, deleteFile: del });
            fdClose();
        }, T('deleteWord'));
}

parent.pluginHandler.filedist.loadMaps = function (msg) {
    if (msg.event.nodeId == fdNodeId()) {
        filemaps = msg.event.mapData;
        doOnLoad();
    }
};

function parseFileTree(tree) {
    if (tree == null) {
        fTree = []; loc = []; niceLoc = [];
        if ((parent.filetree == null) || (parent.filetree.f == null)) return;
        return parseFileTree(parent.filetree.f);
    }
    for (var k in tree) {
        var v = tree[k];
        if (v.t != 3) {
            if (v.t == 4) { loc = []; niceLoc = []; }
            loc.push(k);
            niceLoc.push(v.n || k);
        }
        if (v.t <= 2 || v.t == 4) parseFileTree(v.f);
        if (v.t == 3) {
            fTree.push({ linkpath: loc.join('/') + '/' + k, nicepath: niceLoc.join('/') + '/' + k });
        }
    }
    loc.pop(); niceLoc.pop();
}
</script>
</html>
